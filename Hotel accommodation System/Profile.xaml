<UserControl x:Class="Hotel_accommodation_System.Profile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hotel_accommodation_System"
             mc:Ignorable="d" 
                                                       d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid Background="#191C3281">
        <Border BorderThickness="1" HorizontalAlignment="Left" Height="475" Margin="47,26,0,0" VerticalAlignment="Top" Width="870" Background="White" CornerRadius="10,10,10,10">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <TextBlock Text="Edit Profile" FontSize="20" FontWeight="Bold" Margin="20,10,0,40" Grid.RowSpan="2"/>
                <Line X1="20" X2="780" Y1="50" Y2="50" Stroke="Blue" StrokeThickness="2" Width="860"/>

                <Grid Margin="20,60,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add New Item Section -->
                    <Border BorderThickness="1" Background="White" CornerRadius="10" Padding="20" Grid.Column="0" Margin="10,0,10,-165" BorderBrush="#7F000000" Height="382">
                        <StackPanel>
                            <TextBlock Text="Full Name" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Width="316"/>
                            <TextBox Name="txtfullname" IsReadOnly="True"  Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>

                            <TextBlock Text="Contact Nubmer" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Margin="0,8,0,0" Width="316"/>
                            <TextBox Name="txtcontactno" IsReadOnly="True"  Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>



                            <TextBlock Text="National ID" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Margin="0,8,0,0" Width="316"/>
                            <TextBox Name="txtnationalid" Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>

                            <TextBlock Text="Address" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Margin="0,8,0,0" Width="316"/>
                            <TextBox Name="txtaddress" Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>


                            <TextBlock Text="Email" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Margin="0,8,0,0" Width="316"/>
                            <TextBox Name="txtemail" Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>


                            <Button x:Name="btn_Save_details" Content="Save Details" Background="#337CF5" Foreground="White" Height="40" Width="316" FontSize="14" FontFamily="Segoe UI Semibold" Margin="0,10,0,0" />
                        </StackPanel>

                    </Border>

                    <!-- Update Item Section -->
                    <Border BorderThickness="1" Background="White" CornerRadius="10" Padding="20" Grid.Column="1" Margin="10,0,10,-154" BorderBrush="#7F000000">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Profile.png" Width="170" Height="175" Margin="30,0,0,0"/>
                                <Button x:Name="btn_serach_inventory" Content="Edit" Background="#337CF5" Foreground="White" Width="85" Margin="10,5,0,0"  Height="30"/>
                            </StackPanel>

                            <TextBlock Text="Username" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Width="316" Margin="0,8,0,0" />
                            <TextBox Name="txtusername" Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>


                            <TextBlock Text="Password" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI Semibold" Width="316" Margin="0,7,0,0"/>
                            <PasswordBox Name="txtpass" Height="28" FontSize="14" Margin="0,5,0,0" Width="316"/>


                            <Button x:Name="btn_update_item" Content="Update Details" Background="#28A745" Foreground="White" Height="40" Width="316" FontSize="14" FontFamily="Segoe UI Semibold" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>


            </Grid>
        </Border>

    </Grid>
</UserControl>
