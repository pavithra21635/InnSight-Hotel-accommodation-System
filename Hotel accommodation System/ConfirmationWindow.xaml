<Window x:Class="Hotel_accommodation_System.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_accommodation_System"
        mc:Ignorable="d"
                Title="Confirmation" Height="473" Width="324" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White">

    <Grid Margin="0,0,0,-16">
        <Border BorderBrush="Green" BorderThickness="2" CornerRadius="10" Padding="10" Background="White" Margin="0,0,0,22">
            <StackPanel Margin="0,0,0,-12">
                <Image Source="/confir.png" Height="57" Margin="0,5,0,0"/>
                <TextBlock Text="Confirmation" FontSize="22" FontWeight="Bold" Foreground="#FF30A550" HorizontalAlignment="Left" Margin="85,5,0,0"/>
                <TextBlock x:Name="txt_Price" Text="Total : Rs. 0.00" FontSize="16" Foreground="Red" Margin="88,5,0,0" Width="279" FontWeight="Bold"/>

                <TextBlock x:Name="txt_BookingID" Text="Booking ID: B001" FontSize="14" FontWeight="Bold" Margin="35,10,10,5" Width="340"/>


                <StackPanel Margin="10">
                    <TextBlock x:Name="txt_BookingDate" Text="Date / Time : " FontSize="14" Margin="25,-9,0,10" Width="337"/>
                    <TextBlock x:Name="txt_CustomerName" Text="Customer Name: " FontSize="14" Margin="25,-5,0,5" Width="336"/>
                    <TextBlock x:Name="txt_CustomerMobile" Text="Mobile: " FontSize="14" Margin="25,1,0,5" Width="339"/>
                    <TextBlock x:Name="txt_RoomType" Text="Room Type: " FontSize="14" Margin="25,2,0,5" Width="336"/>
                    <TextBlock x:Name="txt_NoOfPersons" Text="No. of Persons: " FontSize="14" Margin="25,2,0,5" Width="338"/>
                    <TextBlock x:Name="txt_ReservedDate" Text="Reserved Date: " FontSize="14" Margin="25,2,0,5" Width="338"/>
                    <TextBlock x:Name="txt_CheckoutDate" Text="Checkout Date: " FontSize="14" Margin="25,2,0,5" Width="339"/>
                </StackPanel>

                <Button Content="Back" Background="#FF30A550" Foreground="White" FontSize="16" Height="40" Margin="-120,10,10,10" Click="Confirm_Click" Width="120"/>
                <Button x:Name="print" Content="Download" Foreground="White" FontSize="16" Height="40" Margin="160,-50,10,10"
Click="Print_Click" Width="120" BorderBrush="{x:Null}" Background="#FF337CF5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
