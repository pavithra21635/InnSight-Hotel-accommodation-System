<UserControl x:Class="Hotel_accommodation_System.InventoryReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hotel_accommodation_System"
             mc:Ignorable="d" 
                     d:DesignHeight="450" d:DesignWidth="800" Background="White">
    <Grid Background="#191C3281">
        <Border BorderThickness="1" HorizontalAlignment="Left" Height="477" Margin="42,28,0,0" VerticalAlignment="Top" Width="893" Background="White" CornerRadius="10,10,10,10">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->

                <Button Content="&lt;&lt;" Width="30" Height="30" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,7,0,0" Cursor="Hand" Click="BackButton_Click"/>

                <!-- Header -->
                <TextBlock Text="Inventory Reports" FontSize="16" FontWeight="Bold" Margin="50,12,0,18"/>

                <!-- Date Filters -->
                <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top" Margin="50,5,0,20">
                    <TextBlock Text="Select by Date : " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="From : " VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <DatePicker x:Name="startdate_picker" Width="120" SelectedDate="{Binding StartDate}" Height="28" Margin="5,0,0,0" SelectedDateChanged="startdate_picker_SelectedDateChanged"/>
                    <TextBlock Text="To : " VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <DatePicker x:Name="enddate_picker" Width="120" SelectedDate="{Binding EndDate}" Height="28" Margin="5,0,0,0" SelectedDateChanged="enddate_picker_SelectedDateChanged"/>
                    <Button Content="Download" Width="100" Height="35" Background="#2D79F3" Foreground="White" FontWeight="Bold" Margin="200,-2,0,0" Click="download_click"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid x:Name="inventoryreport_datagrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="52,75,57,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Inventory ID" Binding="{Binding InventoryID}" Width="*" />
                        <DataGridTextColumn Header="Room ID" Binding="{Binding RoomID}" Width="*" />
                        <DataGridTextColumn Header="Inventory Name" Binding="{Binding InventoryName}" Width="*" />
                        <DataGridTextColumn Header="Inventory Type" Binding="{Binding InventoryType}" Width="*" />
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="60" />
                        <DataGridTextColumn Header="Create Date" Binding="{Binding CreateDate}" Width="*" />
                        <DataGridTextColumn Header="Updated Date" Binding="{Binding UpdatedDate}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>


            </Grid>
        </Border>

    </Grid>
</UserControl>
